SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-long-random-value
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0
MONGO_DATABASE_NAME=bookverse
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
# Optional for this signed-upload flow.
CLOUDINARY_UPLOAD_PRESET=
# Optional for same-domain Vercel deployment; Vercel supplies VERCEL_URL.
VERCEL_URL=your-project.vercel.app
FRONTEND_URL=https://your-project.vercel.app
# Optional for cross-origin clients. Keep local origins for local development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@bookverse.com
